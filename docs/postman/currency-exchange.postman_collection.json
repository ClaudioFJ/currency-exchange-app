        {
          "name": "Histórico por intervalo (30 dias)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));\r\n\r\nconst json = pm.response.json();\r\n\r\npm.test(\"Retorna array com registros\", () => {\r\n  pm.expect(json).to.be.an(\"array\").that.is.not.empty;\r\n});\r\n\r\npm.test(\"Registros em ordem crescente de data\", () => {\r\n  for (let i = 1; i < json.length; i++) {\r\n    pm.expect(json[i].date >= json[i - 1].date).to.be.true;\r\n  }\r\n});\r\n\r\npm.test(\"Todos os registros são USD → BRL\", () => {\r\n  json.forEach((r) => {\r\n    pm.expect(r.base).to.eql(\"USD\");\r\n    pm.expect(r.quote).to.eql(\"BRL\");\r\n  });\r\n});"
                ]
              }
            }
          ],
