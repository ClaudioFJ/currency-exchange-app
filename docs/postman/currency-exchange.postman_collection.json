      "name": "Sucesso",
      "item": [
        {
          "name": "Moedas disponíveis",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));\r\n\r\nconst json = pm.response.json();\r\n\r\npm.test(\"Retorna um array não vazio\", () => {\r\n  pm.expect(json).to.be.an(\"array\").that.is.not.empty;\r\n});\r\n\r\npm.test(\"Cada moeda tem iso_code e name\", () => {\r\n  json.forEach((moeda) => {\r\n    pm.expect(moeda).to.have.property(\"iso_code\");\r\n    pm.expect(moeda).to.have.property(\"name\");\r\n  });\r\n});\r\n\r\npm.test(\"Lista contém BRL e USD\", () => {\r\n  const codigos = json.map((m) => m.iso_code);\r\n  pm.expect(codigos).to.include.members([\"BRL\", \"USD\"]);\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/currencies",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "currencies"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Cotação mais recente EUR → USD",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));\r\n\r\nconst json = pm.response.json();\r\n\r\npm.test(\"Tem date, base, quote e rate\", () => {\r\n  pm.expect(json).to.include.keys(\"date\", \"base\", \"quote\", \"rate\");\r\n});\r\n\r\npm.test(\"rate é um número positivo\", () => {\r\n  pm.expect(json.rate).to.be.a(\"number\").and.above(0);\r\n});\r\n\r\npm.test(\"Tempo de resposta menor que 2s\", () => {\r\n  pm.expect(pm.response.responseTime).to.be.below(2000);\r\n});"
                ]
              }
            }
          ],
